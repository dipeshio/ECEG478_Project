/*
 * Code for highlighting/unhighlighting TRs
 *
 * Written by:
 *      Paul Aurich <paul@aurich.com>, Pomona College
 */

/*
 * Highlight a row in a table when the mouse is hovering over it.
 * These functions are event handlers for onmouseover and onmouseout
 * respectively
 */
function highlight(el)
{
    if (!el.oldClassName)
        el.oldClassName = el.className;
    el.className = "highlighted";
}

function unhighlight(el)
{
    if (el.oldClassName)
        el.className = el.oldClassName;
}
