/*
 * Javascript code for the "appointment details" windows
 * Nathan Reed, 5/31/2006
 */

/*
 * Return the absolute location of an element's upper-left corner with respect
 * to the document coordinate system; works in all browsers AFAIK
 */
function getElementPos (elem)
{
	var pt = { x: 0, y: 0 }
	var cur = elem;
	while (cur != null)
	{
		pt.x += cur.offsetLeft;
		pt.y += cur.offsetTop;
		cur = cur.offsetParent;
	}
	return pt;
}

/*
 * Displays the details window identified by "id", at the location
 * of the page element "at_elem"
 */
function showDetails (id, at_elem)
{
	details = document.getElementById(id);
	// Move to the appropriate location
	pt = getElementPos(at_elem);
	details.style.left = pt.x + 'px';
	details.style.top = pt.y + 'px';
	details.style.visibility = 'visible';
}

/*
 * Hides the details window
 */
function hideDetails (id)
{
	document.getElementById(id).style.visibility = 'hidden';
}
